{
  "name": "tibo-reset",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Estimate an unscheduled credit reset from public X posts using the Decisions API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.js",
    "test": "node --test",
    "site:export": "node scripts/export-site.mjs",
    "site:refresh": "node --env-file-if-exists=.env scripts/refresh-site.mjs",
    "site:preview": "npm --prefix site run dev"
  },
  "dependencies": {
    "twitter-openapi-typescript": "0.1.3"
  }
}
